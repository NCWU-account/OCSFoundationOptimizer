<Window x:Class="OCSFoundationOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OCSFoundationOptimizer.Models"
        mc:Ignorable="d"
        Title="支柱基础计算"
        Height="950"
        Width="1450"
        MinHeight="720"
        MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <!-- ========================================================= -->
    <!-- 资源 -->
    <!-- ========================================================= -->

    <Window.Resources>

        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter" />

        <!-- ===================================================== -->
        <!-- 基础字体 -->
        <!-- ===================================================== -->

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>


        <!-- ===================================================== -->
        <!-- Section 标题 -->
        <!-- ===================================================== -->

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="#263238" />

        </Style>


        <!-- ===================================================== -->
        <!-- 英文小标题 -->
        <!-- ===================================================== -->

        <Style x:Key="Caption"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="10" />

            <Setter Property="Foreground"
                    Value="#89929C" />

        </Style>


        <!-- ===================================================== -->
        <!-- 参数名称 -->
        <!-- ===================================================== -->

        <Style x:Key="ParameterNameStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="Foreground"
                    Value="#374151" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>


        <!-- ===================================================== -->
        <!-- 参数输入框 -->
        <!-- ===================================================== -->

        <Style x:Key="ParameterTextBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="34" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="#1F2937" />

            <Setter Property="Background"
                    Value="#FAFBFC" />

            <Setter Property="BorderBrush"
                    Value="#CBD3DB" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="9,0" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

        </Style>


        <!-- ===================================================== -->
        <!-- ComboBox -->
        <!-- ===================================================== -->

        <Style x:Key="ParameterComboBox"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="34" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="#1F2937" />

            <Setter Property="Background"
                    Value="#FAFBFC" />

            <Setter Property="BorderBrush"
                    Value="#CBD3DB" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="7,0" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

        </Style>


        <!-- ===================================================== -->
        <!-- 普通操作按钮 -->
        <!-- ===================================================== -->

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Padding"
                    Value="18,0" />

            <Setter Property="Background"
                    Value="#FFFFFF" />

            <Setter Property="Foreground"
                    Value="#374151" />

            <Setter Property="BorderBrush"
                    Value="#CBD3DB" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F4F7FA" />

                    <Setter Property="BorderBrush"
                            Value="#9BAAB8" />

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E9EEF3" />

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- 执行计算按钮 -->
        <!-- ===================================================== -->

        <Style x:Key="ExecuteButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Padding"
                    Value="22,0" />

            <Setter Property="Background"
                    Value="#1F4E79" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#1F4E79" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#285F91" />

                    <Setter Property="BorderBrush"
                            Value="#285F91" />

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#183F63" />

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Background"
                            Value="#B8C4CF" />

                    <Setter Property="BorderBrush"
                            Value="#B8C4CF" />

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- 理论按钮 -->
        <!-- ===================================================== -->

        <Style x:Key="TheoryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="68" />

            <Setter Property="Margin"
                    Value="0,0,0,10" />

            <Setter Property="Background"
                    Value="#F8FAFC" />

            <Setter Property="BorderBrush"
                    Value="#D9E0E6" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="12" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

        </Style>


        <!-- ===================================================== -->
        <!-- 参数模板 -->
        <!-- ===================================================== -->

        <!-- ===================================================== -->
        <!-- 参数模板 -->
        <!-- ===================================================== -->

        <DataTemplate x:Key="ParameterTemplate">

            <Grid Margin="0,0,0,12">

                <Grid.ColumnDefinitions>

                    <!-- 参数名称 -->
                    <ColumnDefinition Width="220" />

                    <!-- 参数输入 -->
                    <ColumnDefinition Width="190" />

                    <!-- 单位 -->
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- 参数名称 -->
                <!-- ================================================= -->

                <Grid Grid.Column="0"
                      VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="12"
                               Foreground="#374151"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />


                    <TextBlock Grid.Column="1"
                               Text="必填"
                               FontSize="9"
                               Foreground="#9AA3AD"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsRequired}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </Grid>


                <!-- ================================================= -->
                <!-- 输入区域 -->
                <!-- ================================================= -->

                <Grid Grid.Column="1"
                      Width="180"
                      Height="34"
                      HorizontalAlignment="Left">


                    <!-- ================================================= -->
                    <!-- Number / 普通文本 -->
                    <!-- ================================================= -->

                    <Border>

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="BorderBrush"
                                        Value="#CBD3DB" />

                                <Setter Property="Background"
                                        Value="#FAFBFC" />

                                <Setter Property="BorderThickness"
                                        Value="1" />

                                <Setter Property="CornerRadius"
                                        Value="3" />


                                <Style.Triggers>

                                    <!-- 参数错误 -->

                                    <DataTrigger Binding="{Binding HasError}"
                                                 Value="True">

                                        <Setter Property="BorderBrush"
                                                Value="#D93025" />

                                        <Setter Property="Background"
                                                Value="#FFF5F5" />

                                    </DataTrigger>


                                    <!-- 只读 -->

                                    <DataTrigger Binding="{Binding IsReadOnly}"
                                                 Value="True">

                                        <Setter Property="Background"
                                                Value="#F1F3F5" />

                                    </DataTrigger>


                                    <!-- Selection 类型隐藏 -->

                                    <DataTrigger Binding="{Binding Type}"
                                                 Value="Selection">

                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>


                        <TextBox
                            Text="{Binding Value,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{Binding IsReadOnly}"
                            FontSize="13"
                            Foreground="#1F2937"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="9,0"
                            VerticalContentAlignment="Center" />

                    </Border>


                    <!-- ================================================= -->
                    <!-- Selection -->
                    <!-- ================================================= -->

                    <ComboBox ItemsSource="{Binding Options}"
                              SelectedValue="{Binding Value,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Text"
                              FontSize="13"
                              Foreground="#1F2937"
                              Background="#FAFBFC"
                              BorderBrush="#CBD3DB"
                              BorderThickness="1"
                              Padding="7,0"
                              VerticalContentAlignment="Center">

                        <ComboBox.Style>

                            <Style TargetType="ComboBox">

                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Setter Property="IsEnabled"
                                        Value="True" />


                                <Style.Triggers>

                                    <!-- Selection 类型显示 -->

                                    <DataTrigger Binding="{Binding Type}"
                                                 Value="Selection">

                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                    </DataTrigger>


                                    <!-- 只读 -->

                                    <DataTrigger Binding="{Binding IsReadOnly}"
                                                 Value="True">

                                        <Setter Property="IsEnabled"
                                                Value="False" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </ComboBox.Style>

                    </ComboBox>

                </Grid>


                <!-- ================================================= -->
                <!-- 单位 -->
                <!-- ================================================= -->

                <TextBlock Grid.Column="2"
                           Text="{Binding Unit}"
                           FontSize="11"
                           Foreground="#7B8490"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />

            </Grid>

        </DataTemplate>


        <!-- ===================================================== -->
        <!-- 结果参数模板 -->
        <!-- ===================================================== -->

        <DataTemplate x:Key="ResultTemplate">

            <Border Margin="0,0,10,12"
                    Padding="12"
                    Background="#F9FAFB"
                    BorderBrush="#E2E7EC"
                    BorderThickness="1"
                    CornerRadius="4">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="6" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Text="{Binding Name}"
                               FontSize="11"
                               Foreground="#69737D" />


                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="{Binding Value}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   VerticalAlignment="Center" />


                        <TextBlock Grid.Column="1"
                                   Text="{Binding Unit}"
                                   FontSize="10"
                                   Foreground="#7B8490"
                                   VerticalAlignment="Bottom"
                                   Margin="8,0,0,2" />

                    </Grid>

                </Grid>

            </Border>

        </DataTemplate>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- 主界面 -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="76" />

            <RowDefinition Height="*" />

            <RowDefinition Height="30" />

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- 顶部 -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="0,0,0,1">

            <Grid Margin="26,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="参数化计算+计算书一键生成"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#718096" />

                    <TextBlock Text="接触网支柱基础优化计算"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Margin="0,3,0,0" />

                </StackPanel>


                <Border Grid.Column="1"
                        MinWidth="145"
                        Background="#F5F7FA"
                        BorderBrush="#D9E0E6"
                        BorderThickness="1"
                        Padding="15,8"
                        VerticalAlignment="Center">

                    <StackPanel>

                        <TextBlock Text="当前计算方案"
                                   FontSize="9"
                                   Foreground="#8A939D" />

                        <TextBlock Text="{Binding CurrentTheoryDisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1F4E79"
                                   Margin="0,2,0,0" />

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- 主体 -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="18">

            <Grid.ColumnDefinitions>

                <!-- 左侧理论 -->

                <ColumnDefinition Width="205" />

                <!-- 中间 -->

                <ColumnDefinition Width="*" />

                <!-- 右侧图片 -->

                <ColumnDefinition Width="500" />

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- 左侧：计算模型 -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#DDE2E7"
                    BorderThickness="1"
                    Margin="0,0,12,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0"
                                Margin="18,18,18,16">

                        <TextBlock Text="计算模型"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="支持不同方式计算，请选择方案"
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />

                    </StackPanel>


                    <!-- 理论 -->

                    <StackPanel Grid.Row="1"
                                Margin="18,0">


                        <!-- 理论 A -->

                        <Button Command="{Binding SelectTheoryACommand}">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource TheoryButton}">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsTheoryASelected}"
                                                     Value="True">

                                            <Setter Property="Background"
                                                    Value="#EEF5FB" />

                                            <Setter Property="BorderBrush"
                                                    Value="#1F4E79" />

                                            <Setter Property="BorderThickness"
                                                    Value="2" />

                                        </DataTrigger>


                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#F1F6FA" />

                                            <Setter Property="BorderBrush"
                                                    Value="#9EB2C3" />

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="28" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>


                                <Ellipse Grid.Column="0"
                                         Width="9"
                                         Height="9"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">

                                    <Ellipse.Style>

                                        <Style TargetType="Ellipse">

                                            <Setter Property="Fill"
                                                    Value="#AAB4BE" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryASelected}"
                                                             Value="True">

                                                    <Setter Property="Fill"
                                                            Value="#1F4E79" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Ellipse.Style>

                                </Ellipse>


                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="理论 A"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#263238" />

                                    <TextBlock Text="计算模型 A"
                                               FontSize="10"
                                               Foreground="#89929C"
                                               Margin="0,3,0,0" />

                                </StackPanel>


                                <TextBlock Grid.Column="2"
                                           Text="✓"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1F4E79"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryASelected}"
                                                             Value="True">

                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Button>


                        <!-- 理论 B -->

                        <Button Command="{Binding SelectTheoryBCommand}">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource TheoryButton}">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsTheoryBSelected}"
                                                     Value="True">

                                            <Setter Property="Background"
                                                    Value="#EEF5FB" />

                                            <Setter Property="BorderBrush"
                                                    Value="#1F4E79" />

                                            <Setter Property="BorderThickness"
                                                    Value="2" />

                                        </DataTrigger>


                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#F1F6FA" />

                                            <Setter Property="BorderBrush"
                                                    Value="#9EB2C3" />

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="28" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>


                                <Ellipse Grid.Column="0"
                                         Width="9"
                                         Height="9"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">

                                    <Ellipse.Style>

                                        <Style TargetType="Ellipse">

                                            <Setter Property="Fill"
                                                    Value="#AAB4BE" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryBSelected}"
                                                             Value="True">

                                                    <Setter Property="Fill"
                                                            Value="#1F4E79" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Ellipse.Style>

                                </Ellipse>


                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="理论 B"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#263238" />

                                    <TextBlock Text="计算模型 B"
                                               FontSize="10"
                                               Foreground="#89929C"
                                               Margin="0,3,0,0" />

                                </StackPanel>


                                <TextBlock Grid.Column="2"
                                           Text="✓"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1F4E79"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryBSelected}"
                                                             Value="True">

                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Button>

                    </StackPanel>


                    <!-- 状态 -->

                    <Border Grid.Row="2"
                            Background="#F7F9FB"
                            BorderBrush="#E3E7EB"
                            BorderThickness="1,1,0,0"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="计算状态"
                                       Style="{StaticResource Caption}" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,7,0,0">

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="#5B8DB8"
                                         VerticalAlignment="Center" />

                                <TextBlock Text="{Binding CalculationStatus}"
                                           FontSize="11"
                                           Foreground="#59636E"
                                           Margin="7,0,0,0"
                                           TextWrapping="Wrap" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- 中间计算区域 -->
            <!-- ================================================= -->

            <Grid Grid.Column="1"
                  Margin="0,0,12,0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="*" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="52" />

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- 输入参数 -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        BorderBrush="#DDE2E7"
                        BorderThickness="1"
                        Margin="0,0,0,12">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="1" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>


                        <!-- 标题 -->

                        <Grid Grid.Row="0"
                              Margin="18,15">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="计算参数"
                                           Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="请输入设计参数"
                                           Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />

                            </StackPanel>




                        </Grid>


                        <!-- 分割线 -->

                        <Border Grid.Row="1"
                                Background="#E6E9ED" />


                        <!-- ================================================= -->
                        <!-- 参数区域 -->
                        <!-- ================================================= -->

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18">

                            <StackPanel>

                                <!-- ================================================= -->
                                <!-- 参数分组 -->
                                <!-- ================================================= -->

                                <ItemsControl ItemsSource="{Binding ParameterGroups}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <StackPanel Margin="0,0,0,20">

                                                <!-- ================================================= -->
                                                <!-- 分组标题 -->
                                                <!-- ================================================= -->

                                                <Border
                                                    Background="#F5F7FA"
                                                    BorderBrush="#DDE3E8"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="10,8"
                                                    Margin="0,0,0,12">

                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1F4E79" />

                                                </Border>


                                                <!-- ================================================= -->
                                                <!-- 当前组参数 -->
                                                <!-- ================================================= -->

                                                <!-- ================================================= -->
                                                <!-- 当前组参数 -->
                                                <!-- ================================================= -->

                                                <ItemsControl ItemsSource="{Binding Parameters}">

                                                    <!-- ================================================= -->
                                                    <!-- 三列布局 -->
                                                    <!-- ================================================= -->

                                                    <ItemsControl.ItemsPanel>

                                                        <ItemsPanelTemplate>

                                                            <UniformGrid Columns="3" />

                                                        </ItemsPanelTemplate>

                                                    </ItemsControl.ItemsPanel>


                                                    <!-- ================================================= -->
                                                    <!-- 参数模板 -->
                                                    <!-- ================================================= -->

                                                    <ItemsControl.ItemTemplate>

                                                        <DataTemplate>

                                                            <Grid Margin="0,0,12,14">

                                                                <Grid.RowDefinitions>

                                                                    <!-- 参数名称 -->
                                                                    <RowDefinition Height="Auto" />

                                                                    <!-- 输入框 -->
                                                                    <RowDefinition Height="34" />

                                                                </Grid.RowDefinitions>


                                                                <!-- ================================================= -->
                                                                <!-- 参数名称 -->
                                                                <!-- ================================================= -->

                                                                <Grid Grid.Row="0"
                                                                      Margin="0,0,0,7">

                                                                    <Grid.ColumnDefinitions>

                                                                        <ColumnDefinition Width="*" />

                                                                        <ColumnDefinition Width="Auto" />

                                                                    </Grid.ColumnDefinitions>


                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        Text="{Binding Name}"
                                                                        FontSize="12"
                                                                        Foreground="#374151"
                                                                        VerticalAlignment="Center"
                                                                        TextTrimming="CharacterEllipsis" />


                                                                    <!-- 必填 -->

                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Text="必填"
                                                                        FontSize="9"
                                                                        Foreground="#9AA3AD"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center">

                                                                        <TextBlock.Style>

                                                                            <Style TargetType="TextBlock">

                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed" />

                                                                                <Style.Triggers>

                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsRequired}"
                                                                                        Value="True">

                                                                                        <Setter
                                                                                            Property="Visibility"
                                                                                            Value="Visible" />

                                                                                    </DataTrigger>

                                                                                </Style.Triggers>

                                                                            </Style>

                                                                        </TextBlock.Style>

                                                                    </TextBlock>

                                                                </Grid>


                                                                <!-- ================================================= -->
                                                                <!-- 输入区域 -->
                                                                <!-- ================================================= -->

                                                                <Grid Grid.Row="1">


                                                                    <!-- ================================================= -->
                                                                    <!-- 普通输入框 -->
                                                                    <!-- ================================================= -->

                                                                    <Border
                                                                        CornerRadius="3"
                                                                        BorderThickness="1">

                                                                        <Border.Style>

                                                                            <Style TargetType="Border">

                                                                                <Setter
                                                                                    Property="BorderBrush"
                                                                                    Value="#CBD3DB" />

                                                                                <Setter
                                                                                    Property="Background"
                                                                                    Value="#FAFBFC" />


                                                                                <Style.Triggers>

                                                                                    <!-- 错误 -->

                                                                                    <DataTrigger
                                                                                        Binding="{Binding HasError}"
                                                                                        Value="True">

                                                                                        <Setter
                                                                                            Property="BorderBrush"
                                                                                            Value="#D93025" />

                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#FFF5F5" />

                                                                                    </DataTrigger>


                                                                                    <!-- 只读 -->

                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsReadOnly}"
                                                                                        Value="True">

                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#F1F3F5" />

                                                                                    </DataTrigger>


                                                                                    <!-- Selection 隐藏 -->

                                                                                    <DataTrigger
                                                                                        Binding="{Binding Type}"
                                                                                        Value="Selection">

                                                                                        <Setter
                                                                                            Property="Visibility"
                                                                                            Value="Collapsed" />

                                                                                    </DataTrigger>

                                                                                </Style.Triggers>

                                                                            </Style>

                                                                        </Border.Style>


                                                                        <TextBox
                                                                            Text="{Binding Value,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                                                            IsReadOnly="{Binding IsReadOnly}"
                                                                            FontSize="13"
                                                                            Foreground="#1F2937"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Padding="9,0"
                                                                            VerticalContentAlignment="Center" />

                                                                    </Border>


                                                                    <!-- ================================================= -->
                                                                    <!-- 下拉框 -->
                                                                    <!-- ================================================= -->

                                                                    <ComboBox
                                                                        ItemsSource="{Binding Options}"
                                                                        SelectedValue="{Binding Value,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"
                                                                        SelectedValuePath="Value"
                                                                        DisplayMemberPath="Text"
                                                                        FontSize="13"
                                                                        Foreground="#1F2937"
                                                                        Background="#FAFBFC"
                                                                        BorderBrush="#CBD3DB"
                                                                        BorderThickness="1"
                                                                        Padding="7,0"
                                                                        VerticalContentAlignment="Center">

                                                                        <ComboBox.Style>

                                                                            <Style TargetType="ComboBox">

                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed" />

                                                                                <Style.Triggers>

                                                                                    <!-- Selection -->

                                                                                    <DataTrigger
                                                                                        Binding="{Binding Type}"
                                                                                        Value="Selection">

                                                                                        <Setter
                                                                                            Property="Visibility"
                                                                                            Value="Visible" />

                                                                                    </DataTrigger>


                                                                                    <!-- 只读 -->

                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsReadOnly}"
                                                                                        Value="True">

                                                                                        <Setter
                                                                                            Property="IsEnabled"
                                                                                            Value="False" />

                                                                                    </DataTrigger>

                                                                                </Style.Triggers>

                                                                            </Style>

                                                                        </ComboBox.Style>

                                                                    </ComboBox>


                                                                    <!-- ================================================= -->
                                                                    <!-- 单位 -->
                                                                    <!-- ================================================= -->

                                                                    <TextBlock
                                                                        Text="{Binding Unit}"
                                                                        FontSize="10"
                                                                        Foreground="#7B8490"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,9,0"
                                                                        IsHitTestVisible="False" />

                                                                </Grid>

                                                            </Grid>

                                                        </DataTemplate>

                                                    </ItemsControl.ItemTemplate>

                                                </ItemsControl>

                                            </StackPanel>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </ScrollViewer>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- 计算结果 -->
                <!-- ================================================= -->

                <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#DDE2E7"
                        BorderThickness="1"
                        Margin="0,0,0,12">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="1" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>


                        <Grid Grid.Row="0"
                              Margin="18,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>


                            <!-- 标题 -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="计算结果"
                                           Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="CALCULATION RESULTS"
                                           Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />

                            </StackPanel>


                            <!-- 当前理论 -->

                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentTheoryDisplayName}"
                                       FontSize="10"
                                       Foreground="#1F4E79"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0" />


                            <!-- 折叠按钮 -->

                            <Button Grid.Column="2"
                                    Content="{Binding ResultToggleText}"
                                    Command="{Binding ToggleResultCommand}"
                                    Height="30"
                                    Padding="12,0"
                                    FontSize="11"
                                    Background="#FFFFFF"
                                    Foreground="#59636E"
                                    BorderBrush="#CBD3DB"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    VerticalAlignment="Center" />

                        </Grid>


                        <Border Grid.Row="1"
                                Background="#E6E9ED" />


                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding ResultParameters}"
                                      ItemTemplate="{StaticResource ResultTemplate}"
                                      Margin="18,14">

                            <ItemsControl.Style>

                                <Style TargetType="ItemsControl">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsResultExpanded}"
                                                     Value="False">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </ItemsControl.Style>


                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <UniformGrid Columns="2"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                        </ItemsControl>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- 底部按钮 -->
                <!-- ================================================= -->

                <Grid Grid.Row="2">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="生成计算书"
                                Width="120"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding GenerateCalculationBookCommand}"
                                Margin="0,0,10,0" />

                        <Button Content="执行计算"
                                Width="125"
                                Style="{StaticResource ExecuteButton}"
                                Command="{Binding CalculateCommand}" />

                    </StackPanel>

                </Grid>

            </Grid>


            <!-- ================================================= -->
            <!-- 右侧结构示意 -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#DDE2E7"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <!-- 标题 -->

                    <StackPanel Grid.Row="0"
                                Margin="18,16">

                        <TextBlock Text="接触网支柱基础深化设计图"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="结构示意"
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- 图片查看区域 -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            Margin="18,0"
                            Background="#F5F7F9"
                            BorderBrush="#E0E5E9"
                            BorderThickness="1"
                            ClipToBounds="True">

                        <Canvas x:Name="ImageViewer"
                                Background="#F5F7F9"
                                ClipToBounds="True"
                                SizeChanged="ImageViewer_SizeChanged"
                                PreviewMouseWheel="ImageViewer_MouseWheel"
                                PreviewMouseLeftButtonDown="ImageViewer_MouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ImageViewer_MouseLeftButtonUp"
                                PreviewMouseMove="ImageViewer_MouseMove">

                            <Image x:Name="SampleImage"
                                   Source="pic/sample.png"
                                   Stretch="None"
                                   Width="Auto"
                                   Height="Auto"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0,0">

                                <Image.RenderTransform>

                                    <TransformGroup>

                                        <ScaleTransform x:Name="ImageScale"
                                                        ScaleX="1"
                                                        ScaleY="1" />

                                        <TranslateTransform x:Name="ImageTranslate"
                                                            X="0"
                                                            Y="0" />

                                    </TransformGroup>

                                </Image.RenderTransform>

                            </Image>


                            <!-- 右上角提示 -->

                            <Border Canvas.Right="10"
                                    Canvas.Top="10"
                                    Background="#EFFFFFFF"
                                    Padding="9,6"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">

                                <TextBlock Text="滚轮缩放  ·  左键拖动  ·  双击复位"
                                           FontSize="10"
                                           Foreground="#68737D" />

                            </Border>


                            <!-- 左下角图片尺寸 -->

                            <Border Canvas.Left="10"
                                    Canvas.Bottom="10"
                                    Background="#EFFFFFFF"
                                    Padding="8,5"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">

                                <TextBlock Text="4219 × 2840"
                                           FontSize="10"
                                           Foreground="#7B8490" />

                            </Border>

                        </Canvas>

                    </Border>


                    <!-- 图片说明 -->

                    <StackPanel Grid.Row="2"
                                Margin="18,12,18,15">

                        <TextBlock Text="查看方式"
                                   Style="{StaticResource Caption}" />

                        <TextBlock Text="滚动鼠标滚轮缩放示意图，按住鼠标左键可拖动图片，双击恢复默认视图。"
                                   FontSize="11"
                                   Foreground="#69737D"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- 底部状态栏 -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="0,1,0,0">

            <Grid Margin="18,0">

                <TextBlock Text="OCS Foundation Optimizer"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="#8A939D" />

                <TextBlock Text="Ready"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="#8A939D" />

            </Grid>

        </Border>

    </Grid>

</Window>