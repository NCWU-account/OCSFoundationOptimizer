<Window x:Class="OCSFoundationOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:OCSFoundationOptimizer.View"
        mc:Ignorable="d"
        Title="支柱基础计算"
        Height="950"
        Width="1450"
        MinHeight="720"
        MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="View/Resources/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <view:HeaderView Grid.Row="0" />

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <view:TheorySelectorView Grid.Column="0" Margin="0,0,12,0" />

            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="#DDE2E7"
                    BorderThickness="1"
                    Margin="0,0,12,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <!-- 标题 -->

                    <StackPanel Grid.Row="0"
                                Margin="18,16">

                        <TextBlock Text="接触网支柱基础深化设计图"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="结构示意"
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- 图片查看区域 -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            Margin="18,0"
                            Background="#F5F7F9"
                            BorderBrush="#E0E5E9"
                            BorderThickness="1"
                            ClipToBounds="True">

                        <Canvas x:Name="ImageViewer"
                                Background="#F5F7F9"
                                ClipToBounds="True"
                                SizeChanged="ImageViewer_SizeChanged"
                                PreviewMouseWheel="ImageViewer_MouseWheel"
                                PreviewMouseLeftButtonDown="ImageViewer_MouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ImageViewer_MouseLeftButtonUp"
                                PreviewMouseMove="ImageViewer_MouseMove">

                            <Image x:Name="SampleImage"
                                   Source="pic/sample.png"
                                   Stretch="None"
                                   Width="Auto"
                                   Height="Auto"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0,0">

                                <Image.RenderTransform>

                                    <TransformGroup>

                                        <ScaleTransform x:Name="ImageScale"
                                                        ScaleX="1"
                                                        ScaleY="1" />

                                        <TranslateTransform x:Name="ImageTranslate"
                                                            X="0"
                                                            Y="0" />

                                    </TransformGroup>

                                </Image.RenderTransform>

                            </Image>


                            <!-- 右上角提示 -->

                            <Border Canvas.Right="10"
                                    Canvas.Top="10"
                                    Background="#EFFFFFFF"
                                    Padding="9,6"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">

                                <TextBlock Text="滚轮缩放  ·  左键拖动  ·  双击复位"
                                           FontSize="10"
                                           Foreground="#68737D" />

                            </Border>


                            <!-- 左下角图片尺寸 -->

                            <Border Canvas.Left="10"
                                    Canvas.Bottom="10"
                                    Background="#EFFFFFFF"
                                    Padding="8,5"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">

                                <TextBlock Text="4219 × 2840"
                                           FontSize="10"
                                           Foreground="#7B8490" />

                            </Border>

                        </Canvas>

                    </Border>


                    <!-- 图片说明 -->

                    <StackPanel Grid.Row="2"
                                Margin="18,12,18,15">

                        <TextBlock Text="查看方式"
                                   Style="{StaticResource Caption}" />

                        <TextBlock Text="滚动鼠标滚轮缩放示意图，按住鼠标左键可拖动图片，双击恢复默认视图。"
                                   FontSize="11"
                                   Foreground="#69737D"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />

                    </StackPanel>

                </Grid>

            </Border>


            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <view:ParameterPanelView Grid.Row="0" Margin="0,0,0,12" />
                <view:ResultView Grid.Row="1" Margin="0,0,0,12" />
                <view:ActionBarView Grid.Row="2" />
            </Grid>
        </Grid>

        <view:FooterView Grid.Row="2" />
    </Grid>
</Window>
