<Window x:Class="OCSFoundationOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OCS基础优化计算"
        Height="850"
        Width="1400"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <!-- ========================================================= -->
    <!-- 资源 -->
    <!-- ========================================================= -->

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- 基础字体 -->
        <!-- ===================================================== -->

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>


        <!-- ===================================================== -->
        <!-- Section 标题 -->
        <!-- ===================================================== -->

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="#263238" />

        </Style>


        <!-- ===================================================== -->
        <!-- 英文小标题 -->
        <!-- ===================================================== -->

        <Style x:Key="Caption"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="10" />

            <Setter Property="Foreground"
                    Value="#89929C" />

        </Style>


        <!-- ===================================================== -->
        <!-- 理论按钮 -->
        <!-- ===================================================== -->

        <Style x:Key="TheoryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="70" />

            <Setter Property="Margin"
                    Value="0,0,0,12" />

            <Setter Property="Background"
                    Value="#F8FAFC" />

            <Setter Property="BorderBrush"
                    Value="#D9E0E6" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="12" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

        </Style>


        <!-- ===================================================== -->
        <!-- 普通操作按钮 -->
        <!-- ===================================================== -->

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Padding"
                    Value="18,0" />

            <Setter Property="Background"
                    Value="#FFFFFF" />

            <Setter Property="Foreground"
                    Value="#374151" />

            <Setter Property="BorderBrush"
                    Value="#CBD3DB" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F4F7FA" />

                    <Setter Property="BorderBrush"
                            Value="#9BAAB8" />

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E9EEF3" />

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- 执行按钮 -->
        <!-- ===================================================== -->

        <Style x:Key="ExecuteButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Padding"
                    Value="22,0" />

            <Setter Property="Background"
                    Value="#1F4E79" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#1F4E79" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#285F91" />

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#183F63" />

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Background"
                            Value="#B8C4CF" />

                    <Setter Property="BorderBrush"
                            Value="#B8C4CF" />

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- 输入参数 -->
        <!-- ===================================================== -->

        <DataTemplate x:Key="ParameterTemplate">

            <Grid Margin="0,0,0,14">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="125" />

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="48" />

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#374151" />


                <Border Grid.Column="1"
                        Height="34"
                        Background="#FAFBFC"
                        BorderBrush="#CBD3DB"
                        BorderThickness="1"
                        CornerRadius="3">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter Property="BorderBrush"
                                    Value="#CBD3DB" />

                            <Setter Property="Background"
                                    Value="#FAFBFC" />

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding HasError}"
                                             Value="True">

                                    <Setter Property="BorderBrush"
                                            Value="#D93025" />

                                    <Setter Property="Background"
                                            Value="#FFF5F5" />

                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsReadOnly}"
                                             Value="True">

                                    <Setter Property="Background"
                                            Value="#F1F3F5" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>


                    <TextBox Text="{Binding Value,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsReadOnly}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="9,0"
                             FontSize="13"
                             Foreground="#1F2937"
                             VerticalContentAlignment="Center" />

                </Border>


                <TextBlock Grid.Column="2"
                           Text="{Binding Unit}"
                           VerticalAlignment="Center"
                           Margin="9,0,0,0"
                           FontSize="12"
                           Foreground="#7B8490" />

            </Grid>

        </DataTemplate>


        <!-- ===================================================== -->
        <!-- 结果参数 -->
        <!-- ===================================================== -->

        <DataTemplate x:Key="ResultTemplate">

            <Grid Margin="0,0,0,13">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="150" />

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="55" />

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#4B5563" />


                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1F2937" />


                <TextBlock Grid.Column="2"
                           Text="{Binding Unit}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#7B8490" />

            </Grid>

        </DataTemplate>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- 主界面 -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="76" />

            <RowDefinition Height="*" />

            <RowDefinition Height="30" />

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- 顶部 -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="0,0,0,1">

            <Grid Margin="26,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="OCS FOUNDATION OPTIMIZER"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#718096" />

                    <TextBlock Text="接触网钢柱基础优化计算"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Margin="0,3,0,0" />

                </StackPanel>


                <Border Grid.Column="1"
                        MinWidth="145"
                        Background="#F5F7FA"
                        BorderBrush="#D9E0E6"
                        BorderThickness="1"
                        Padding="15,8"
                        VerticalAlignment="Center">

                    <StackPanel>

                        <TextBlock Text="CURRENT MODEL"
                                   FontSize="9"
                                   Foreground="#8A939D" />

                        <TextBlock Text="{Binding CurrentTheoryDisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1F4E79"
                                   Margin="0,2,0,0" />

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- 主体 -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="18">

            <Grid.ColumnDefinitions>

                <!-- 左侧 -->
                <ColumnDefinition Width="205" />

                <!-- 中间 -->
                <ColumnDefinition Width="*" />

                <!-- 右侧 -->
                <ColumnDefinition Width="540" />

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- 左侧：计算模型 -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#DDE2E7"
                    BorderThickness="1"
                    Margin="0,0,12,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0"
                                Margin="18,18,18,16">

                        <TextBlock Text="计算模型"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="CALCULATION MODEL"
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />

                    </StackPanel>


                    <StackPanel Grid.Row="1"
                                Margin="18,0">


                        <!-- 理论 A -->

                        <Button Command="{Binding SelectTheoryACommand}">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource TheoryButton}">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsTheoryASelected}"
                                                     Value="True">

                                            <Setter Property="Background"
                                                    Value="#EEF5FB" />

                                            <Setter Property="BorderBrush"
                                                    Value="#1F4E79" />

                                            <Setter Property="BorderThickness"
                                                    Value="2" />

                                        </DataTrigger>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#F1F6FA" />

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="32" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>


                                <Ellipse Grid.Column="0"
                                         Width="10"
                                         Height="10"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">

                                    <Ellipse.Style>

                                        <Style TargetType="Ellipse">

                                            <Setter Property="Fill"
                                                    Value="#AAB4BE" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryASelected}"
                                                             Value="True">

                                                    <Setter Property="Fill"
                                                            Value="#1F4E79" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Ellipse.Style>

                                </Ellipse>


                                <StackPanel Grid.Column="1"
                                            Margin="9,0,0,0">

                                    <TextBlock Text="理论 A"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#263238" />

                                    <TextBlock Text="计算模型 A"
                                               FontSize="11"
                                               Foreground="#89929C"
                                               Margin="0,3,0,0" />

                                </StackPanel>


                                <TextBlock Grid.Column="2"
                                           Text="✓"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1F4E79"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryASelected}"
                                                             Value="True">

                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Button>


                        <!-- 理论 B -->

                        <Button Command="{Binding SelectTheoryBCommand}">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource TheoryButton}">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsTheoryBSelected}"
                                                     Value="True">

                                            <Setter Property="Background"
                                                    Value="#EEF5FB" />

                                            <Setter Property="BorderBrush"
                                                    Value="#1F4E79" />

                                            <Setter Property="BorderThickness"
                                                    Value="2" />

                                        </DataTrigger>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#F1F6FA" />

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="32" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>


                                <Ellipse Grid.Column="0"
                                         Width="10"
                                         Height="10"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">

                                    <Ellipse.Style>

                                        <Style TargetType="Ellipse">

                                            <Setter Property="Fill"
                                                    Value="#AAB4BE" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryBSelected}"
                                                             Value="True">

                                                    <Setter Property="Fill"
                                                            Value="#1F4E79" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Ellipse.Style>

                                </Ellipse>


                                <StackPanel Grid.Column="1"
                                            Margin="9,0,0,0">

                                    <TextBlock Text="理论 B"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#263238" />

                                    <TextBlock Text="计算模型 B"
                                               FontSize="11"
                                               Foreground="#89929C"
                                               Margin="0,3,0,0" />

                                </StackPanel>


                                <TextBlock Grid.Column="2"
                                           Text="✓"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1F4E79"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryBSelected}"
                                                             Value="True">

                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Button>

                    </StackPanel>


                    <Border Grid.Row="2"
                            Background="#F7F9FB"
                            BorderBrush="#E3E7EB"
                            BorderThickness="1,1,0,0"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="计算状态"
                                       Style="{StaticResource Caption}" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,7,0,0">

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="#5B8DB8"
                                         VerticalAlignment="Center" />

                                <TextBlock Text="{Binding CalculationStatus}"
                                           FontSize="11"
                                           Foreground="#59636E"
                                           Margin="7,0,0,0"
                                           TextWrapping="Wrap" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- 中间 -->
            <!-- ================================================= -->

            <Grid Grid.Column="1"
                  Margin="0,0,12,0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="*" />

                    <RowDefinition Height="*" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>


                <!-- 输入参数 -->

                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        BorderBrush="#DDE2E7"
                        BorderThickness="1"
                        Margin="0,0,0,12">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="1" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0"
                                    Margin="18,16">

                            <TextBlock Text="计算参数"
                                       Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="INPUT PARAMETERS"
                                       Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />

                        </StackPanel>


                        <Border Grid.Row="1"
                                Background="#E6E9ED" />


                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18">

                            <ItemsControl ItemsSource="{Binding InputParameters}"
                                          ItemTemplate="{StaticResource ParameterTemplate}" />

                        </ScrollViewer>

                    </Grid>

                </Border>


                <!-- 计算结果 -->

                <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#DDE2E7"
                        BorderThickness="1"
                        Margin="0,0,0,12">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="1" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0"
                                    Margin="18,16">

                            <TextBlock Text="计算结果"
                                       Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="CALCULATION RESULTS"
                                       Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />

                        </StackPanel>


                        <Border Grid.Row="1"
                                Background="#E6E9ED" />


                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="18">

                            <ItemsControl ItemsSource="{Binding ResultParameters}"
                                          ItemTemplate="{StaticResource ResultTemplate}" />

                        </ScrollViewer>

                    </Grid>

                </Border>


                <!-- 底部按钮 -->

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="生成计算书"
                            Width="120"
                            Style="{StaticResource ActionButton}"
                            Command="{Binding GenerateCalculationBookCommand}"
                            Margin="0,0,10,0" />

                    <Button Content="执行计算"
                            Width="125"
                            Style="{StaticResource ExecuteButton}"
                            Command="{Binding CalculateCommand}" />

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- 右侧：结构示意图 -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#DDE2E7"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <!-- 标题 -->

                    <StackPanel Grid.Row="0"
                                Margin="18,16">

                        <TextBlock Text="结构示意"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="STRUCTURAL SCHEMATIC"
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- 图片查看区域 -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            Margin="18,0"
                            Background="#F5F7F9"
                            BorderBrush="#E0E5E9"
                            BorderThickness="1"
                            ClipToBounds="True">

                        <Grid x:Name="ImageViewer"
                              Background="#F5F7F9"
                              ClipToBounds="True">


                            <!-- ================================================= -->
                            <!-- ScrollViewer -->
                            <!-- ================================================= -->

                            <ScrollViewer x:Name="ImageScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Background="#F5F7F9"
                                          CanContentScroll="False"
                                          PanningMode="None"
                                          Focusable="False"
                                          IsHitTestVisible="True"
                                          PreviewMouseWheel="ImageViewer_MouseWheel"
                                          PreviewMouseLeftButtonDown="ImageViewer_MouseLeftButtonDown"
                                          PreviewMouseLeftButtonUp="ImageViewer_MouseLeftButtonUp"
                                          PreviewMouseMove="ImageViewer_MouseMove"
                                          PreviewMouseDoubleClick="ImageViewer_MouseDoubleClick">

                                <Grid>

                                    <!-- ================================================= -->
                                    <!-- 图片 -->
                                    <!-- ================================================= -->

                                    <Image x:Name="SampleImage"
                                           Source="pic/sample.png"
                                           Stretch="None"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderTransformOrigin="0,0">

                                        <Image.RenderTransform>

                                            <TransformGroup>

                                                <!-- 缩放 -->

                                                <ScaleTransform x:Name="ImageScale"
                                                                ScaleX="1"
                                                                ScaleY="1" />

                                                <!-- 平移 -->

                                                <TranslateTransform x:Name="ImageTranslate"
                                                                     X="0"
                                                                     Y="0" />

                                            </TransformGroup>

                                        </Image.RenderTransform>

                                    </Image>

                                </Grid>

                            </ScrollViewer>


                            <!-- ================================================= -->
                            <!-- 右上角提示 -->
                            <!-- ================================================= -->

                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Background="#EFFFFFFF"
                                    Padding="9,6"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">

                                <TextBlock Text="滚轮缩放  ·  左键拖动  ·  双击复位"
                                           FontSize="10"
                                           Foreground="#68737D" />

                            </Border>


                            <!-- ================================================= -->
                            <!-- 左下角图片尺寸 -->
                            <!-- ================================================= -->

                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="10"
                                    Background="#EFFFFFFF"
                                    Padding="8,5"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">

                                <TextBlock Text="4219 × 2840"
                                           FontSize="10"
                                           Foreground="#7B8490" />

                            </Border>


                            <!-- ================================================= -->
                            <!-- 中央提示 -->
                            <!-- ================================================= -->

                            <TextBlock Text="结构示意图"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#A0A8B0"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- 图片说明 -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="2"
                                Margin="18,12,18,15">

                        <TextBlock Text="查看方式"
                                   Style="{StaticResource Caption}" />

                        <TextBlock Text="滚动鼠标滚轮缩放示意图，按住鼠标左键拖动图片，双击恢复自适应显示。"
                                   FontSize="11"
                                   Foreground="#69737D"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- 底部状态栏 -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="0,1,0,0">

            <Grid Margin="18,0">

                <TextBlock Text="OCS Foundation Optimizer"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="#8A939D" />

                <TextBlock Text="Ready"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="#8A939D" />

            </Grid>

        </Border>

    </Grid>

</Window>