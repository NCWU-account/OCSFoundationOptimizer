<Window x:Class="OCSFoundationOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OCS基础优化计算"
        Height="850"
        Width="1450"
        MinHeight="720"
        MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <!-- ========================================================= -->
    <!-- 资源 -->
    <!-- ========================================================= -->

    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter" />
        <!-- ===================================================== -->
        <!-- 基础字体 -->
        <!-- ===================================================== -->

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily"
                    Value="Microsoft YaHei UI" />
        </Style>


        <!-- ===================================================== -->
        <!-- Section 标题 -->
        <!-- ===================================================== -->

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="#263238" />

        </Style>


        <!-- ===================================================== -->
        <!-- 英文小标题 -->
        <!-- ===================================================== -->

        <Style x:Key="Caption"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="10" />

            <Setter Property="Foreground"
                    Value="#89929C" />

        </Style>


        <!-- ===================================================== -->
        <!-- 参数名称 -->
        <!-- ===================================================== -->

        <Style x:Key="ParameterNameStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="Foreground"
                    Value="#4B5563" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>


        <!-- ===================================================== -->
        <!-- 参数输入框 -->
        <!-- ===================================================== -->

        <Style x:Key="ParameterTextBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="36" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="#1F2937" />

            <Setter Property="Background"
                    Value="#FAFBFC" />

            <Setter Property="BorderBrush"
                    Value="#CBD3DB" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="10,0" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

        </Style>


        <!-- ===================================================== -->
        <!-- 输入参数模板 -->
        <!-- ===================================================== -->

        <DataTemplate x:Key="ParameterTemplate">

            <Border Margin="0,0,10,12"
                    Padding="12"
                    Background="#FFFFFF"
                    BorderBrush="#E2E7EC"
                    BorderThickness="1"
                    CornerRadius="4">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="8" />

                        <RowDefinition Height="36" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <!-- 参数名称 -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   Style="{StaticResource ParameterNameStyle}" />


                        <!-- 必填标识 -->

                        <TextBlock Grid.Column="1"
                                   Text="必填"
                                   FontSize="9"
                                   Foreground="#9AA3AD"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsRequired,
                                Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>


                    <!-- 输入区域 -->

                    <Border Grid.Row="2"
                            Background="#FAFBFC"
                            BorderBrush="#CBD3DB"
                            BorderThickness="1"
                            CornerRadius="3">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>


                            <!-- 输入框 -->

                            <TextBox Grid.Column="0"
                                     Text="{Binding Value,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Style="{StaticResource ParameterTextBox}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="9,0" />


                            <!-- 单位 -->

                            <Border Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="#EEF1F4"
                                    CornerRadius="2"
                                    Padding="7,3">

                                <TextBlock Text="{Binding Unit}"
                                           FontSize="10"
                                           Foreground="#69737D" />

                            </Border>

                        </Grid>


                        <!-- 参数错误 -->

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="BorderBrush"
                                        Value="#CBD3DB" />

                                <Setter Property="Background"
                                        Value="#FAFBFC" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasError}"
                                                 Value="True">

                                        <Setter Property="BorderBrush"
                                                Value="#D93025" />

                                        <Setter Property="Background"
                                                Value="#FFF7F7" />

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsReadOnly}"
                                                 Value="True">

                                        <Setter Property="Background"
                                                Value="#F1F3F5" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                    </Border>


                    <!-- 错误提示 -->

                    <TextBlock Grid.Row="3"
                               Text="{Binding ErrorMessage}"
                               FontSize="10"
                               Foreground="#D93025"
                               Margin="2,5,0,0"
                               TextWrapping="Wrap">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasError}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

            </Border>

        </DataTemplate>


        <!-- ===================================================== -->
        <!-- 结果参数模板 -->
        <!-- ===================================================== -->

        <DataTemplate x:Key="ResultTemplate">

            <Border Margin="0,0,10,12"
                    Padding="12"
                    Background="#F9FAFB"
                    BorderBrush="#E2E7EC"
                    BorderThickness="1"
                    CornerRadius="4">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="6" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <!-- 名称 -->

                    <TextBlock Grid.Row="0"
                               Text="{Binding Name}"
                               FontSize="11"
                               Foreground="#69737D" />


                    <!-- 数值 -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="{Binding Value}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   VerticalAlignment="Center" />


                        <TextBlock Grid.Column="1"
                                   Text="{Binding Unit}"
                                   FontSize="10"
                                   Foreground="#7B8490"
                                   VerticalAlignment="Bottom"
                                   Margin="8,0,0,2" />

                    </Grid>

                </Grid>

            </Border>

        </DataTemplate>


        <!-- ===================================================== -->
        <!-- 普通操作按钮 -->
        <!-- ===================================================== -->

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Padding"
                    Value="18,0" />

            <Setter Property="Background"
                    Value="#FFFFFF" />

            <Setter Property="Foreground"
                    Value="#374151" />

            <Setter Property="BorderBrush"
                    Value="#CBD3DB" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F4F7FA" />

                    <Setter Property="BorderBrush"
                            Value="#9BAAB8" />

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E9EEF3" />

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- 执行计算按钮 -->
        <!-- ===================================================== -->

        <Style x:Key="ExecuteButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Padding"
                    Value="22,0" />

            <Setter Property="Background"
                    Value="#1F4E79" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#1F4E79" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#285F91" />

                    <Setter Property="BorderBrush"
                            Value="#285F91" />

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#183F63" />

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Background"
                            Value="#B8C4CF" />

                    <Setter Property="BorderBrush"
                            Value="#B8C4CF" />

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- 理论按钮 -->
        <!-- ===================================================== -->

        <Style x:Key="TheoryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="68" />

            <Setter Property="Margin"
                    Value="0,0,0,10" />

            <Setter Property="Background"
                    Value="#F8FAFC" />

            <Setter Property="BorderBrush"
                    Value="#D9E0E6" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="12" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- 主界面 -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="76" />

            <RowDefinition Height="*" />

            <RowDefinition Height="30" />

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- 顶部 -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="0,0,0,1">

            <Grid Margin="26,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="OCS FOUNDATION OPTIMIZER"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#718096" />

                    <TextBlock Text="接触网钢柱基础优化计算"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Margin="0,3,0,0" />

                </StackPanel>


                <Border Grid.Column="1"
                        MinWidth="145"
                        Background="#F5F7FA"
                        BorderBrush="#D9E0E6"
                        BorderThickness="1"
                        Padding="15,8"
                        VerticalAlignment="Center">

                    <StackPanel>

                        <TextBlock Text="CURRENT MODEL"
                                   FontSize="9"
                                   Foreground="#8A939D" />

                        <TextBlock Text="{Binding CurrentTheoryDisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1F4E79"
                                   Margin="0,2,0,0" />

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- 主体 -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="18">

            <Grid.ColumnDefinitions>

                <!-- 左侧理论 -->

                <ColumnDefinition Width="205" />

                <!-- 中间计算区 -->

                <ColumnDefinition Width="*" />

                <!-- 右侧图片 -->

                <ColumnDefinition Width="500" />

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- 左侧：计算模型 -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#DDE2E7"
                    BorderThickness="1"
                    Margin="0,0,12,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <!-- 标题 -->

                    <StackPanel Grid.Row="0"
                                Margin="18,18,18,16">

                        <TextBlock Text="计算模型"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="CALCULATION MODEL"
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />

                    </StackPanel>


                    <!-- 理论选择 -->

                    <StackPanel Grid.Row="1"
                                Margin="18,0">


                        <!-- 理论 A -->

                        <Button Command="{Binding SelectTheoryACommand}">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource TheoryButton}">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsTheoryASelected}"
                                                     Value="True">

                                            <Setter Property="Background"
                                                    Value="#EEF5FB" />

                                            <Setter Property="BorderBrush"
                                                    Value="#1F4E79" />

                                            <Setter Property="BorderThickness"
                                                    Value="2" />

                                        </DataTrigger>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#F1F6FA" />

                                            <Setter Property="BorderBrush"
                                                    Value="#9EB2C3" />

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="28" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>


                                <Ellipse Grid.Column="0"
                                         Width="9"
                                         Height="9"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">

                                    <Ellipse.Style>

                                        <Style TargetType="Ellipse">

                                            <Setter Property="Fill"
                                                    Value="#AAB4BE" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryASelected}"
                                                             Value="True">

                                                    <Setter Property="Fill"
                                                            Value="#1F4E79" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Ellipse.Style>

                                </Ellipse>


                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="理论 A"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#263238" />

                                    <TextBlock Text="计算模型 A"
                                               FontSize="10"
                                               Foreground="#89929C"
                                               Margin="0,3,0,0" />

                                </StackPanel>


                                <TextBlock Grid.Column="2"
                                           Text="✓"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1F4E79"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryASelected}"
                                                             Value="True">

                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Button>


                        <!-- 理论 B -->

                        <Button Command="{Binding SelectTheoryBCommand}">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource TheoryButton}">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsTheoryBSelected}"
                                                     Value="True">

                                            <Setter Property="Background"
                                                    Value="#EEF5FB" />

                                            <Setter Property="BorderBrush"
                                                    Value="#1F4E79" />

                                            <Setter Property="BorderThickness"
                                                    Value="2" />

                                        </DataTrigger>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#F1F6FA" />

                                            <Setter Property="BorderBrush"
                                                    Value="#9EB2C3" />

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="28" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>


                                <Ellipse Grid.Column="0"
                                         Width="9"
                                         Height="9"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">

                                    <Ellipse.Style>

                                        <Style TargetType="Ellipse">

                                            <Setter Property="Fill"
                                                    Value="#AAB4BE" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryBSelected}"
                                                             Value="True">

                                                    <Setter Property="Fill"
                                                            Value="#1F4E79" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Ellipse.Style>

                                </Ellipse>


                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="理论 B"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#263238" />

                                    <TextBlock Text="计算模型 B"
                                               FontSize="10"
                                               Foreground="#89929C"
                                               Margin="0,3,0,0" />

                                </StackPanel>


                                <TextBlock Grid.Column="2"
                                           Text="✓"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1F4E79"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsTheoryBSelected}"
                                                             Value="True">

                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Button>

                    </StackPanel>


                    <!-- 状态 -->

                    <Border Grid.Row="2"
                            Background="#F7F9FB"
                            BorderBrush="#E3E7EB"
                            BorderThickness="1,1,0,0"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="计算状态"
                                       Style="{StaticResource Caption}" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,7,0,0">

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="#5B8DB8"
                                         VerticalAlignment="Center" />

                                <TextBlock Text="{Binding CalculationStatus}"
                                           FontSize="11"
                                           Foreground="#59636E"
                                           Margin="7,0,0,0"
                                           TextWrapping="Wrap" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- 中间 -->
            <!-- ================================================= -->

            <Grid Grid.Column="1"
                  Margin="0,0,12,0">

                <Grid.RowDefinitions>

                    <!-- 输入区域 -->

                    <RowDefinition Height="*" />

                    <!-- 结果区域根据内容 -->

                    <RowDefinition Height="Auto" />

                    <!-- 按钮 -->

                    <RowDefinition Height="52" />

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- 输入参数 -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        BorderBrush="#DDE2E7"
                        BorderThickness="1"
                        Margin="0,0,0,12">

                    <Grid>

                        <Grid.RowDefinitions>

                            <!-- 标题 -->
                            <RowDefinition Height="Auto" />

                            <!-- 分割线 -->
                            <RowDefinition Height="1" />

                            <!-- 参数 -->
                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>


                        <!-- ================================================= -->
                        <!-- 标题 -->
                        <!-- ================================================= -->

                        <Grid Grid.Row="0"
                              Margin="18,15">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="计算参数"
                                           Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="INPUT PARAMETERS"
                                           Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />

                            </StackPanel>


                            <TextBlock Grid.Column="1"
                                       Text="请输入设计参数"
                                       FontSize="10"
                                       Foreground="#9AA3AD"
                                       VerticalAlignment="Center" />

                        </Grid>


                        <!-- ================================================= -->
                        <!-- 分割线 -->
                        <!-- ================================================= -->

                        <Border Grid.Row="1"
                                Background="#E6E9ED" />


                        <!-- ================================================= -->
                        <!-- 参数区域 -->
                        <!-- ================================================= -->

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18">

                            <ItemsControl ItemsSource="{Binding InputParameters}">


                                <!-- ================================================= -->
                                <!-- 三列布局 -->
                                <!-- ================================================= -->

                                <ItemsControl.ItemsPanel>

                                    <ItemsPanelTemplate>

                                        <UniformGrid Columns="3" />

                                    </ItemsPanelTemplate>

                                </ItemsControl.ItemsPanel>


                                <!-- ================================================= -->
                                <!-- 参数模板 -->
                                <!-- ================================================= -->

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,0,14,16">

                                            <Grid.RowDefinitions>

                                                <!-- 参数名称 -->
                                                <RowDefinition Height="Auto" />

                                                <!-- 名称与输入框间距 -->
                                                <RowDefinition Height="5" />

                                                <!-- 输入框 -->
                                                <RowDefinition Height="34" />

                                            </Grid.RowDefinitions>


                                            <!-- ================================================= -->
                                            <!-- 参数名称 -->
                                            <!-- ================================================= -->

                                            <Grid Grid.Row="0">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="Auto" />

                                                </Grid.ColumnDefinitions>


                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="#374151"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />


                                                <TextBlock Grid.Column="1"
                                                           Text="必填"
                                                           FontSize="9"
                                                           Foreground="#9AA3AD"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0"
                                                           Visibility="{Binding IsRequired,
                                                Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            </Grid>


                                            <!-- ================================================= -->
                                            <!-- 输入框 -->
                                            <!-- ================================================= -->

                                            <Grid Grid.Row="2">

                                                <Grid.ColumnDefinitions>

                                                    <!-- 输入区域 -->
                                                    <ColumnDefinition Width="150" />

                                                    <!-- 单位 -->
                                                    <ColumnDefinition Width="Auto" />

                                                </Grid.ColumnDefinitions>


                                                <!-- ================================================= -->
                                                <!-- 输入框 -->
                                                <!-- ================================================= -->

                                                <Border Grid.Column="0"
                                                        Width="150"
                                                        Height="34"
                                                        HorizontalAlignment="Left"
                                                        Background="#FAFBFC"
                                                        BorderBrush="#CBD3DB"
                                                        BorderThickness="1"
                                                        CornerRadius="3">

                                                    <Border.Style>

                                                        <Style TargetType="Border">

                                                            <Setter Property="BorderBrush"
                                                                    Value="#CBD3DB" />

                                                            <Setter Property="Background"
                                                                    Value="#FAFBFC" />

                                                            <Style.Triggers>


                                                                <!-- 错误 -->

                                                                <DataTrigger Binding="{Binding HasError}"
                                                                             Value="True">

                                                                    <Setter Property="BorderBrush"
                                                                            Value="#D93025" />

                                                                    <Setter Property="Background"
                                                                            Value="#FFF5F5" />

                                                                </DataTrigger>


                                                                <!-- 只读 -->

                                                                <DataTrigger Binding="{Binding IsReadOnly}"
                                                                             Value="True">

                                                                    <Setter Property="Background"
                                                                            Value="#F1F3F5" />

                                                                </DataTrigger>


                                                                <!-- 鼠标悬停 -->

                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">

                                                                    <Setter Property="BorderBrush"
                                                                            Value="#9BAAB8" />

                                                                </Trigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </Border.Style>


                                                    <TextBox
                                                        Text="{Binding Value,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                        IsReadOnly="{Binding IsReadOnly}"
                                                        Style="{StaticResource ParameterTextBox}" />

                                                </Border>


                                                <!-- ================================================= -->
                                                <!-- 单位 -->
                                                <!-- ================================================= -->

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Unit}"
                                                           FontSize="11"
                                                           Foreground="#7B8490"
                                                           VerticalAlignment="Center"
                                                           Margin="7,0,0,0" />

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- 计算结果 -->
                <!-- ================================================= -->

                <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#DDE2E7"
                        BorderThickness="1"
                        Margin="0,0,0,12">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="1" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>


                        <!-- 标题 -->

                        <Grid Grid.Row="0"
                              Margin="18,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="计算结果"
                                           Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="CALCULATION RESULTS"
                                           Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />

                            </StackPanel>


                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentTheoryDisplayName}"
                                       FontSize="10"
                                       Foreground="#1F4E79"
                                       VerticalAlignment="Center" />

                        </Grid>


                        <Border Grid.Row="1"
                                Background="#E6E9ED" />


                        <!-- 结果两列 -->

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding ResultParameters}"
                                      ItemTemplate="{StaticResource ResultTemplate}"
                                      Margin="18,14">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <UniformGrid Columns="2" />

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                        </ItemsControl>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- 底部按钮 -->
                <!-- ================================================= -->

                <Grid Grid.Row="2">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="生成计算书"
                                Width="120"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding GenerateCalculationBookCommand}"
                                Margin="0,0,10,0" />

                        <Button Content="执行计算"
                                Width="125"
                                Style="{StaticResource ExecuteButton}"
                                Command="{Binding CalculateCommand}" />

                    </StackPanel>

                </Grid>

            </Grid>


            <!-- ================================================= -->
            <!-- 右侧结构示意 -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#DDE2E7"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>


                    <!-- 标题 -->

                    <StackPanel Grid.Row="0"
                                Margin="18,16">

                        <TextBlock Text="结构示意"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="STRUCTURAL SCHEMATIC"
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />

                    </StackPanel>


                    <!-- 图片 -->

                    <!-- ================================================= -->
                    <!-- 图片查看区域 -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            Margin="18,0"
                            Background="#F5F7F9"
                            BorderBrush="#E0E5E9"
                            BorderThickness="1"
                            ClipToBounds="True">

                        <Canvas x:Name="ImageViewer"
                                Background="#F5F7F9"
                                ClipToBounds="True"
                                SizeChanged="ImageViewer_SizeChanged"
                                PreviewMouseWheel="ImageViewer_MouseWheel"
                                PreviewMouseLeftButtonDown="ImageViewer_MouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ImageViewer_MouseLeftButtonUp"
                                PreviewMouseMove="ImageViewer_MouseMove">

                            <Image x:Name="SampleImage"
                                   Source="pic/sample.png"
                                   Stretch="None"
                                   Width="Auto"
                                   Height="Auto"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0,0">

                                <Image.RenderTransform>

                                    <TransformGroup>

                                        <ScaleTransform x:Name="ImageScale"
                                                        ScaleX="1"
                                                        ScaleY="1" />

                                        <TranslateTransform x:Name="ImageTranslate"
                                                            X="0"
                                                            Y="0" />

                                    </TransformGroup>

                                </Image.RenderTransform>

                            </Image>

                            <!-- 右上角提示 -->
                            <Border Canvas.Right="10"
                                    Canvas.Top="10"
                                    Background="#EFFFFFFF"
                                    Padding="9,6"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">

                                <TextBlock Text="滚轮缩放  ·  左键拖动  ·  双击复位"
                                           FontSize="10"
                                           Foreground="#68737D" />

                            </Border>

                            <!-- 左下角图片尺寸 -->
                            <Border Canvas.Left="10"
                                    Canvas.Bottom="10"
                                    Background="#EFFFFFFF"
                                    Padding="8,5"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">

                                <TextBlock Text="4219 × 2840"
                                           FontSize="10"
                                           Foreground="#7B8490" />

                            </Border>

                        </Canvas>

                    </Border>


                    <!-- 图片说明 -->

                    <StackPanel Grid.Row="2"
                                Margin="18,12,18,15">

                        <TextBlock Text="查看方式"
                                   Style="{StaticResource Caption}" />

                        <TextBlock Text="滚动鼠标滚轮缩放示意图，按住鼠标左键可拖动图片，双击恢复默认视图。"
                                   FontSize="11"
                                   Foreground="#69737D"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- 底部状态栏 -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="0,1,0,0">

            <Grid Margin="18,0">

                <TextBlock Text="OCS Foundation Optimizer"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="#8A939D" />

                <TextBlock Text="Ready"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="#8A939D" />

            </Grid>

        </Border>

    </Grid>

</Window>