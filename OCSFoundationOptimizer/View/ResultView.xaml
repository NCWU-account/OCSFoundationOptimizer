<UserControl x:Class="OCSFoundationOptimizer.View.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ResultTemplate">
                    <Border Margin="0,0,10,12"
                            Padding="12"
                            Background="#F9FAFB"
                            BorderBrush="#E2E7EC"
                            BorderThickness="1"
                            CornerRadius="4">
        
                        <Grid>
        
                            <Grid.RowDefinitions>
        
                                <RowDefinition Height="Auto" />
        
                                <RowDefinition Height="6" />
        
                                <RowDefinition Height="Auto" />
        
                            </Grid.RowDefinitions>
        
        
                            <TextBlock Grid.Row="0"
                                       Text="{Binding Name}"
                                       FontSize="11"
                                       Foreground="#69737D" />
        
        
                            <Grid Grid.Row="2">
        
                                <Grid.ColumnDefinitions>
        
                                    <ColumnDefinition Width="*" />
        
                                    <ColumnDefinition Width="Auto" />
        
                                </Grid.ColumnDefinitions>
        
        
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Value}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           VerticalAlignment="Center" />
        
        
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Unit}"
                                           FontSize="10"
                                           Foreground="#7B8490"
                                           VerticalAlignment="Bottom"
                                           Margin="8,0,0,2" />
        
                            </Grid>
        
                        </Grid>
        
                    </Border>
        
                </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
                        Background="#FFFFFF"
                        BorderBrush="#DDE2E7"
                        BorderThickness="1"
                        Margin="0,0,0,12">
                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="1" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>


                        <Grid Grid.Row="0"
                              Margin="18,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>


                            <!-- 标题 -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="计算结果"
                                           Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="CALCULATION RESULTS"
                                           Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />

                            </StackPanel>


                            <!-- 当前理论 -->

                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentTheoryDisplayName}"
                                       FontSize="10"
                                       Foreground="#1F4E79"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0" />


                            <!-- 折叠按钮 -->

                            <Button Grid.Column="2"
                                    Content="{Binding ResultToggleText}"
                                    Command="{Binding ToggleResultCommand}"
                                    Height="30"
                                    Padding="12,0"
                                    FontSize="11"
                                    Background="#FFFFFF"
                                    Foreground="#59636E"
                                    BorderBrush="#CBD3DB"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    VerticalAlignment="Center" />

                        </Grid>


                        <Border Grid.Row="1"
                                Background="#E6E9ED" />


                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding ResultParameters}"
                                      ItemTemplate="{StaticResource ResultTemplate}"
                                      Margin="18,14">

                            <ItemsControl.Style>

                                <Style TargetType="ItemsControl">

                                    <Setter Property="Visibility"
                                            Value="Visible" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsResultExpanded}"
                                                     Value="False">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </ItemsControl.Style>


                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <UniformGrid Columns="2" />

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                        </ItemsControl>

                    </Grid>

                </Border>

</UserControl>
