<UserControl x:Class="OCSFoundationOptimizer.View.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="0,0,0,1">

            <Grid Margin="26,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="参数化计算+计算书一键生成"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#718096" />

                    <TextBlock Text="接触网支柱基础优化计算"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Margin="0,3,0,0" />

                </StackPanel>


                <Border Grid.Column="1"
                        MinWidth="145"
                        Background="#F5F7FA"
                        BorderBrush="#D9E0E6"
                        BorderThickness="1"
                        Padding="15,8"
                        VerticalAlignment="Center">

                    <StackPanel>

                        <TextBlock Text="当前计算方案"
                                   FontSize="9"
                                   Foreground="#8A939D" />

                        <TextBlock Text="{Binding CurrentTheoryDisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1F4E79"
                                   Margin="0,2,0,0" />

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

</UserControl>
