<UserControl x:Class="OCSFoundationOptimizer.View.ActionBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <Button Content="生成计算书"
                    Width="120"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding GenerateCalculationBookCommand}"
                    Margin="0,0,10,0" />


            <!-- ================================================= -->
            <!-- 理论 A：执行计算 -->
            <!-- ================================================= -->

            <Button Content="执行计算"
                    Width="125"
                    Command="{Binding CalculateCommand}">

                <Button.Style>

                    <Style TargetType="Button"
                           BasedOn="{StaticResource ExecuteButton}">

                        <Setter
                            Property="Visibility"
                            Value="Visible" />

                        <Style.Triggers>

                            <!-- 理论 A 优化时隐藏 -->
                            <DataTrigger
                                Binding="{Binding IsTheoryAOptimizationSelected}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </Button.Style>

            </Button>


            <!-- ================================================= -->
            <!-- 理论 A 优化：开始优化 -->
            <!-- ================================================= -->

            <Button Content="开始优化"
                    Width="125"
                    Command="{Binding OptimizeCommand}">

                <Button.Style>

                    <Style TargetType="Button"
                           BasedOn="{StaticResource ExecuteButton}">

                        <Setter Property="Visibility"
                                Value="Collapsed" />

                        <Style.Triggers>

                            <!-- 理论 A 优化时显示 -->
                            <DataTrigger
                                Binding="{Binding IsTheoryAOptimizationSelected}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>