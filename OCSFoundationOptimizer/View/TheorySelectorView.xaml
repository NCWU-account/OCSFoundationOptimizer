<UserControl x:Class="OCSFoundationOptimizer.View.TheorySelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                    Source="Resources/CommonStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>


    <Border
        Background="#FFFFFF"
        BorderBrush="#DDE2E7"
        BorderThickness="1"
        Margin="0,0,12,0">

        <Grid>

            <Grid.RowDefinitions>

                <!-- 标题 -->
                <RowDefinition Height="Auto" />

                <!-- 三个选择项 -->
                <RowDefinition Height="*" />

                <!-- 状态 -->
                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- 标题 -->
            <!-- ================================================= -->

            <StackPanel
                Grid.Row="0"
                Margin="18,18,18,16">

                <TextBlock
                    Text="计算模型"
                    Style="{StaticResource SectionTitle}" />

                <TextBlock
                    Text="支持不同方式计算，请选择方案"
                    Style="{StaticResource Caption}"
                    Margin="0,3,0,0" />

            </StackPanel>


            <!-- ================================================= -->
            <!-- 三种方案 -->
            <!-- ================================================= -->

            <StackPanel
                Grid.Row="1"
                Margin="18,0">


                <!-- ================================================= -->
                <!-- 理论 A -->
                <!-- ================================================= -->

                <Button
                    Command="{Binding SelectTheoryACommand}">

                    <Button.Style>

                        <Style
                            TargetType="Button"
                            BasedOn="{StaticResource TheoryButton}">

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsTheoryASelected}"
                                    Value="True">

                                    <Setter
                                        Property="Background"
                                        Value="#EEF5FB" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="#1F4E79" />

                                    <Setter
                                        Property="BorderThickness"
                                        Value="2" />

                                </DataTrigger>


                                <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                    <Setter
                                        Property="Background"
                                        Value="#F1F6FA" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="#9EB2C3" />

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="28" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>


                        <!-- 状态圆点 -->

                        <Ellipse
                            Grid.Column="0"
                            Width="9"
                            Height="9"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Ellipse.Style>

                                <Style TargetType="Ellipse">

                                    <Setter
                                        Property="Fill"
                                        Value="#AAB4BE" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsTheoryASelected}"
                                            Value="True">

                                            <Setter
                                                Property="Fill"
                                                Value="#1F4E79" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Ellipse.Style>

                        </Ellipse>


                        <!-- 文字 -->

                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                Text="白皮书"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#263238" />

                            <TextBlock
                                Text="《建筑地基基础设计规范》（GB 50007-2011）"
                                FontSize="10"
                                Foreground="#89929C"
                                Margin="0,3,0,0" />

                        </StackPanel>


                        <!-- 对勾 -->

                        <TextBlock
                            Grid.Column="2"
                            Text="✓"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1F4E79"
                            VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style
                                    TargetType="TextBlock">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsTheoryASelected}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Button>


                <!-- ================================================= -->
                <!-- 理论 A 优化 -->
                <!-- ================================================= -->

                <Button
                    Command="{Binding SelectTheoryAOptimizationCommand}">

                    <Button.Style>

                        <Style
                            TargetType="Button"
                            BasedOn="{StaticResource TheoryButton}">

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsTheoryAOptimizationSelected}"
                                    Value="True">

                                    <Setter
                                        Property="Background"
                                        Value="#EEF5FB" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="#1F4E79" />

                                    <Setter
                                        Property="BorderThickness"
                                        Value="2" />

                                </DataTrigger>


                                <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                    <Setter
                                        Property="Background"
                                        Value="#F1F6FA" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="#9EB2C3" />

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="28" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>


                        <!-- 状态圆点 -->

                        <Ellipse
                            Grid.Column="0"
                            Width="9"
                            Height="9"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Ellipse.Style>

                                <Style TargetType="Ellipse">

                                    <Setter
                                        Property="Fill"
                                        Value="#AAB4BE" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsTheoryAOptimizationSelected}"
                                            Value="True">

                                            <Setter
                                                Property="Fill"
                                                Value="#1F4E79" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Ellipse.Style>

                        </Ellipse>


                        <!-- 文字 -->

                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                Text="白皮书优化"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#263238" />

                            <TextBlock
                                Text="反向优化设计"
                                FontSize="10"
                                Foreground="#89929C"
                                Margin="0,3,0,0" />

                        </StackPanel>


                        <!-- 对勾 -->

                        <TextBlock
                            Grid.Column="2"
                            Text="✓"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1F4E79"
                            VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style
                                    TargetType="TextBlock">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsTheoryAOptimizationSelected}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Button>


                <!-- ================================================= -->
                <!-- 理论 B -->
                <!-- ================================================= -->

                <Button
                    Command="{Binding SelectTheoryBCommand}">

                    <Button.Style>

                        <Style
                            TargetType="Button"
                            BasedOn="{StaticResource TheoryButton}">

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsTheoryBSelected}"
                                    Value="True">

                                    <Setter
                                        Property="Background"
                                        Value="#EEF5FB" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="#1F4E79" />

                                    <Setter
                                        Property="BorderThickness"
                                        Value="2" />

                                </DataTrigger>


                                <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                    <Setter
                                        Property="Background"
                                        Value="#F1F6FA" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="#9EB2C3" />

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="28" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>


                        <!-- 状态圆点 -->

                        <Ellipse
                            Grid.Column="0"
                            Width="9"
                            Height="9"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Ellipse.Style>

                                <Style TargetType="Ellipse">

                                    <Setter
                                        Property="Fill"
                                        Value="#AAB4BE" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsTheoryBSelected}"
                                            Value="True">

                                            <Setter
                                                Property="Fill"
                                                Value="#1F4E79" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Ellipse.Style>

                        </Ellipse>


                        <!-- 文字 -->

                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                Text="蓝皮书"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#263238" />

                            <TextBlock
                                Text="《电气化铁道设计手册接触网》（1983）"
                                FontSize="10"
                                Foreground="#89929C"
                                Margin="0,3,0,0" />

                        </StackPanel>


                        <!-- 对勾 -->

                        <TextBlock
                            Grid.Column="2"
                            Text="✓"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1F4E79"
                            VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style
                                    TargetType="TextBlock">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsTheoryBSelected}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Button>
                <!-- ================================================= -->
                <!-- 理论 B 优化 -->
                <!-- ================================================= -->

                <Button
                    Command="{Binding SelectTheoryBOptimizationCommand}">

                    <Button.Style>

                        <Style
                            TargetType="Button"
                            BasedOn="{StaticResource TheoryButton}">

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsTheoryBOptimizationSelected}"
                                    Value="True">

                                    <Setter
                                        Property="Background"
                                        Value="#EEF5FB" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="#1F4E79" />

                                    <Setter
                                        Property="BorderThickness"
                                        Value="2" />

                                </DataTrigger>


                                <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                    <Setter
                                        Property="Background"
                                        Value="#F1F6FA" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="#9EB2C3" />

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="28" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>


                        <!-- 状态圆点 -->

                        <Ellipse
                            Grid.Column="0"
                            Width="9"
                            Height="9"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Ellipse.Style>

                                <Style TargetType="Ellipse">

                                    <Setter
                                        Property="Fill"
                                        Value="#AAB4BE" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsTheoryBOptimizationSelected}"
                                            Value="True">

                                            <Setter
                                                Property="Fill"
                                                Value="#1F4E79" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Ellipse.Style>

                        </Ellipse>


                        <!-- 文字 -->

                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                Text="蓝皮书优化"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#263238" />

                            <TextBlock
                                Text="反向优化设计"
                                FontSize="10"
                                Foreground="#89929C"
                                Margin="0,3,0,0" />

                        </StackPanel>


                        <!-- 对勾 -->

                        <TextBlock
                            Grid.Column="2"
                            Text="✓"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1F4E79"
                            VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style
                                    TargetType="TextBlock">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsTheoryBOptimizationSelected}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Button>


            </StackPanel>


            <!-- ================================================= -->
            <!-- 状态 -->
            <!-- ================================================= -->

            <Border
                Grid.Row="2"
                Background="#F7F9FB"
                BorderBrush="#E3E7EB"
                BorderThickness="1,1,0,0"
                Padding="18">

                <StackPanel>

                    <TextBlock
                        Text="计算状态"
                        Style="{StaticResource Caption}" />


                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,7,0,0">

                        <Ellipse
                            Width="7"
                            Height="7"
                            Fill="#5B8DB8"
                            VerticalAlignment="Center" />


                        <TextBlock
                            Text="{Binding CalculationStatus}"
                            FontSize="11"
                            Foreground="#59636E"
                            Margin="7,0,0,0"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</UserControl>